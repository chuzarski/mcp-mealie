# Copy to .env and fill in. Real environment variables always win over this file.
MEALIE_URL=https://mealie.example.com
MEALIE_API_TOKEN=your-long-lived-token

# Optional
# MEALIE_READ_ONLY=false
# MEALIE_VERIFY_SSL=true
# MEALIE_LOG_LEVEL=INFO
# MEALIE_MAX_CONCURRENCY=4

# HTTP mode (default is stdio). Needs a reverse proxy that checks credentials.
# MEALIE_MCP_TRANSPORT=http
# MEALIE_MCP_HOST=127.0.0.1
# MEALIE_MCP_PORT=8000
# MEALIE_MCP_ALLOWED_HOSTS=mcp.example.org
